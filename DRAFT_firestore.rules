    match /auditLogs/{auditId} {
      allow get: if isValidId(auditId) && (resource == null || resource.data.auditId == auditId) && hasProjectConfig();
      allow list: if resource.data.outcome in ['success', 'failure', 'denied'];
      allow create: if isValidId(auditId) && isValidAuditLog(incoming()) && incoming().auditId == auditId && hasProjectConfig();
