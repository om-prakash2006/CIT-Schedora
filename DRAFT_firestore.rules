      allow get: if isValidId(runId) && hasProjectConfig();
      allow list: if hasProjectConfig();
      allow create: if isValidId(runId) && hasProjectConfig();
      allow update: if isValidId(runId) && hasProjectConfig();
      allow delete: if false;

      match /decisions/{requestId} {
        allow get: if isValidId(requestId) && hasProjectConfig();
        allow list: if hasProjectConfig();
        allow create: if isValidId(requestId) && hasProjectConfig();
        allow update: if isValidId(requestId) && hasProjectConfig();
