      allow update: if isAdmin() && isValidId(requestId) && isValidUnavailabilityRequest(incoming()) && incoming().requestId == existing().requestId && incoming().facultyId == existing().facultyId && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
