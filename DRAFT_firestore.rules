    match /systemSettings/{settingKey} {
      allow get: if isSignedIn() && isValidId(settingKey) && (resource.data.settingKey == settingKey || isAdmin());
      allow list: if isSignedIn() && (resource.data.settingKey is string || isAdmin());
      allow create: if isAdmin() && isValidId(settingKey) && isValidSystemSetting(incoming()) && incoming().settingKey == settingKey && incoming().updatedByUserId == request.auth.uid && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingKey) && isValidSystemSetting(incoming()) && incoming().settingKey == existing().settingKey && incoming().updatedByUserId == request.auth.uid && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['updatedByUserId', 'updatedAt']);
      allow delete: if false;
    }

    match /exportRecords/{exportId} {
      allow get: if isAdmin() && isValidId(exportId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(exportId) && isValidExportRecord(incoming()) && incoming().exportId == exportId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
