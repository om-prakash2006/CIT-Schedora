      match /validationReports/{reportId} {
        allow get: if isValidId(reportId) && (resource == null || resource.data.reportId == reportId) && hasProjectConfig();
        allow list: if hasProjectConfig();
        allow create: if isValidId(reportId) && isValidExamValidationReport(incoming()) && incoming().reportId == reportId && incoming().examScheduleId == examScheduleId && hasProjectConfig();
        allow update: if isValidId(reportId) && isValidExamValidationReport(incoming()) && incoming().reportId == existing().reportId && incoming().examScheduleId == existing().examScheduleId && hasProjectConfig();
        allow delete: if false;
      }
    }

    match /bookingRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.requesterUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.requesterUserId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(requestId) && isValidBookingRequest(incoming()) && incoming().requestId == requestId && incoming().requesterUserId == request.auth.uid && incoming().status == 'pending' && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(requestId) && isValidBookingRequest(incoming()) && incoming().requestId == existing().requestId && incoming().requesterUserId == existing().requesterUserId && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (existing().requesterUserId == request.auth.uid && existing().status == 'pending' && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
      allow delete: if false;
    }

    match /bookingDecisions/{decisionId} {
      allow get: if isSignedIn() && isValidId(decisionId) && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/bookingRequests/$(resource.data.requestId)) &&
         get(/databases/$(database)/documents/bookingRequests/$(resource.data.requestId)).data.requesterUserId == request.auth.uid)
      );
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(decisionId) && isValidBookingDecision(incoming()) && incoming().decisionId == decisionId && incoming().decidedAt == request.time && exists(/databases/$(database)/documents/bookingRequests/$(incoming().requestId));
      allow update: if false;
      allow delete: if false;
    }

