      allow create: if isAdmin() && isValidId(disruptionId) && isValidDisruptionRecord(incoming()) && incoming().disruptionId == disruptionId && exists(/databases/$(database)/documents/datasets/$(incoming().datasetId));
      allow update: if isAdmin() && isValidId(disruptionId) && isValidDisruptionRecord(incoming()) && incoming().disruptionId == existing().disruptionId && incoming().datasetId == existing().datasetId && existing().status != 'applied' && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if false;
