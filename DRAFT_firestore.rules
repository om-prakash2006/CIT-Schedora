    match /manualAllocations/{allocationId} {
      allow get: if isAdmin() && isValidId(allocationId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(allocationId) && isValidManualAllocation(incoming()) && incoming().allocationId == allocationId && incoming().adminUserId == request.auth.uid && incoming().feasibilityVerified == true;
      allow update: if false;
      allow delete: if false;
    }

    match /approvalRecords/{approvalId} {
      allow get: if isAdmin() && isValidId(approvalId);
      allow list: if isAdmin();
