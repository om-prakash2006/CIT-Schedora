      allow update: if isAdmin() && isValidId(repairId) && isValidRepairResult(incoming()) && incoming().repairId == existing().repairId && incoming().disruptionId == existing().disruptionId && existing().approvalDecision == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['approvalDecision']);
      allow delete: if false;
    }

    match /appliedChanges/{changeId} {
      allow get: if isAdmin() && isValidId(changeId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(changeId) && isValidAppliedChange(incoming()) && incoming().changeId == changeId && incoming().approvedByUid == request.auth.uid && incoming().appliedAt == request.time && exists(/databases/$(database)/documents/repairResults/$(incoming().repairId));
      allow update: if false;
