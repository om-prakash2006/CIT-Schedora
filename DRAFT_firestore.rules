    match /sessionChangeRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.facultyId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.facultyId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(requestId) && isValidSessionChangeRequest(incoming()) && incoming().requestId == requestId && incoming().facultyId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(requestId) && isValidSessionChangeRequest(incoming()) && incoming().requestId == existing().requestId && incoming().facultyId == existing().facultyId && existing().status in ['pending', 'endorsed'] && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
