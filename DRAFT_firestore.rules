      allow create: if isVerifiedUser() && isValidId(requestId) && isValidAdditionalSessionRequest(incoming()) && incoming().requestId == requestId && incoming().facultyId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(requestId) && isValidAdditionalSessionRequest(incoming()) && incoming().requestId == existing().requestId && incoming().facultyId == existing().facultyId && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
