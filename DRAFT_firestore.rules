    match /rescheduleProposals/{proposalId} {
      allow get: if isAdmin() && isValidId(proposalId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(proposalId) && isValidRescheduleProposal(incoming()) && incoming().proposalId == proposalId && exists(/databases/$(database)/documents/disruptionRecords/$(incoming().disruptionId));
      allow update: if isAdmin() && isValidId(proposalId) && isValidRescheduleProposal(incoming()) && incoming().proposalId == existing().proposalId && incoming().disruptionId == existing().disruptionId && existing().status == 'staged' && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
