# CIT Schedora — existing Google Cloud / Firebase project
GOOGLE_CLOUD_PROJECT=cit-schedora
FIREBASE_PROJECT_ID=cit-schedora

# Mandatory existing named Firestore database
FIRESTORE_DATABASE_ID=ai-studio-citschedora-f4f986f9-b368-44a8-97a0-e8053dab69b9

# Existing Google Cloud region
FIREBASE_REGION=asia-south1

# Application
APP_NAME=CIT Schedora
NODE_ENV=development
APP_ENV=development

# Gemini — server side only
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Demo access & seeding
VITE_DEMO_ACCESS_ENABLED=true
DEMO_SEED_ENABLED=false

# Private solver service
SOLVER_SERVICE_URL=http://127.0.0.1:8001
SOLVER_TIMEOUT_SECONDS=30

# Frontend Firebase Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=cit-schedora.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cit-schedora
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIRESTORE_DATABASE_ID=ai-studio-citschedora-f4f986f9-b368-44a8-97a0-e8053dab69b9
